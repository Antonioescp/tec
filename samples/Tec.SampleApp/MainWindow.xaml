<Window x:Class="Tec.SampleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App de ejemplo para TEC" Width="520" Height="460"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="OnSave" />
    </Window.CommandBindings>

    <Grid>
    <StackPanel Margin="16">
        <TextBlock Text="Nombre del cliente:" />
        <TextBox x:Name="CustomerName" AutomationProperties.Name="Nombre del cliente" Margin="0,4,0,8" KeyDown="OnCustomerKeyDown" />

        <TextBlock Text="Contraseña:" />
        <PasswordBox AutomationProperties.Name="Contraseña" Margin="0,4,0,12" />

        <StackPanel Orientation="Horizontal">
            <Button Content="Procesar" Padding="16,6" Click="OnProcess" ToolTip="Muestra una ventana de espera y luego el resultado" />
            <Button Content="Guardar (Ctrl+S)" Padding="16,6" Margin="8,0,0,0" Command="{x:Static ApplicationCommands.Save}" />
            <Button Content="Cargar datos" Padding="16,6" Margin="8,0,0,0" Click="OnLoadData" ToolTip="Muestra un overlay de carga dentro de esta ventana" />
        </StackPanel>

        <ListBox x:Name="DataList" AutomationProperties.Name="Datos" Height="90" Margin="0,12,0,0" Visibility="Collapsed" />

        <!-- Fondo rojo para comprobar que TEC cambia el color del recuadro. -->
        <Border Background="#D00000" Padding="16" Margin="0,16,0,0" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Zona roja" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Eliminar" Background="#B00000" Foreground="White" BorderBrush="#900000" Padding="16,6" Click="OnDelete" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="#555" />
    </StackPanel>

    <!-- Overlay de carga dentro de la misma ventana (no es una ventana nueva). -->
    <Grid x:Name="LoadingOverlay" Background="#B0000000" Visibility="Collapsed">
        <Border Background="White" CornerRadius="6" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Cargando datos…" FontSize="16" Margin="0,0,0,10" />
                <ProgressBar IsIndeterminate="True" Width="200" Height="12" />
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
