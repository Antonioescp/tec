<Window x:Class="Tec.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tec.App.Localization"
        Title="TEC — Test Evidence Collector"
        Width="760" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <!-- Application under test -->
        <GroupBox DockPanel.Dock="Top" Header="{Binding [TargetGroup], Source={x:Static loc:Localizer.Instance}}" Padding="6">
            <DockPanel IsEnabled="{Binding IsIdle}">
                <Button DockPanel.Dock="Right" Content="{Binding [LaunchApp], Source={x:Static loc:Localizer.Instance}}" Command="{Binding LaunchCommand}" />
                <Button DockPanel.Dock="Right" Content="{Binding [Refresh], Source={x:Static loc:Localizer.Instance}}" Command="{Binding RefreshProcessesCommand}" />
                <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" />
            </DockPanel>
        </GroupBox>

        <!-- Options -->
        <GroupBox DockPanel.Dock="Top" Header="{Binding [OptionsGroup], Source={x:Static loc:Localizer.Instance}}" Padding="6" Margin="0,8,0,0">
            <Grid IsEnabled="{Binding IsIdle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding [LanguageLabel], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,0,0,6"
                          ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Name" />

                <TextBlock Grid.Row="1" Text="{Binding [CaptureLabel], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <WrapPanel Grid.Row="1" Grid.Column="1">
                    <CheckBox Content="{Binding [Clicks], Source={x:Static loc:Localizer.Instance}}" IsChecked="{Binding CaptureClicks}" />
                    <CheckBox Content="{Binding [KeyboardCommands], Source={x:Static loc:Localizer.Instance}}" IsChecked="{Binding CaptureKeyboardCommands}" />
                    <CheckBox Content="{Binding [TextInput], Source={x:Static loc:Localizer.Instance}}" IsChecked="{Binding CaptureTextInput}" />
                    <CheckBox Content="{Binding [NewWindows], Source={x:Static loc:Localizer.Instance}}" IsChecked="{Binding CaptureWindows}" />
                    <CheckBox Content="{Binding [ScreenChanges], Source={x:Static loc:Localizer.Instance}}" IsChecked="{Binding CaptureContentChanges}"
                              ToolTip="{Binding [ScreenChangesTooltip], Source={x:Static loc:Localizer.Instance}}" />
                </WrapPanel>

                <TextBlock Grid.Row="2" Text="{Binding [AreaLabel], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" Margin="0,6,8,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox Width="200" ItemsSource="{Binding CaptureAreas}" SelectedItem="{Binding SelectedArea}" DisplayMemberPath="Label" />
                    <TextBlock Text="{Binding [WindowDelayLabel], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="60" Text="{Binding WindowSettleDelayMs, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{Binding [FolderLabel], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" Margin="0,6,8,0" />
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="{Binding [Browse], Source={x:Static loc:Localizer.Instance}}" Command="{Binding BrowseOutputCommand}" />
                    <TextBox Text="{Binding OutputRoot}" VerticalContentAlignment="Center" />
                </DockPanel>

                <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Content="{Binding [MinimizeOnStart], Source={x:Static loc:Localizer.Instance}}" IsChecked="{Binding MinimizeOnStart}" />
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding [OpenReport], Source={x:Static loc:Localizer.Instance}}" Command="{Binding OpenReportCommand}" />
                <Button Content="{Binding [OpenFolder], Source={x:Static loc:Localizer.Instance}}" Command="{Binding OpenFolderCommand}" />
                <Button Content="{Binding [ViewLogs], Source={x:Static loc:Localizer.Instance}}" Command="{Binding OpenLogsCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding [Start], Source={x:Static loc:Localizer.Instance}}" Margin="0" FontWeight="SemiBold" Command="{Binding StartCommand}" />
                <Button Content="{Binding [Stop], Source={x:Static loc:Localizer.Instance}}" Command="{Binding StopCommand}" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#444" />

        <!-- Evidence -->
        <ListBox ItemsSource="{Binding Evidences}" SelectedItem="{Binding SelectedEvidence}"
                 MouseDoubleClick="OnEvidenceDoubleClick" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Foreground="#666" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
